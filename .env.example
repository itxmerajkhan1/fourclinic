# Server-side Gemini API key (configured in Settings > Secrets or Vercel Environment Variables)
GEMINI_API_KEY=

# Optional override for initial verified admin email checked on server & rules
BOOTSTRAP_ADMIN_EMAIL=

# Optional Upstash Redis REST credentials for multi-instance Vercel rate limiting on /api/chat
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

