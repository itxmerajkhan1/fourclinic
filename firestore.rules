rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Pillar 0: Global default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // ==================== GLOBAL HELPERS ====================
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isAnonymousAuth() {
      return isSignedIn() && request.auth.token.firebase.sign_in_provider == 'anonymous';
    }

    function isEmailUser() {
      return isSignedIn() && !isAnonymousAuth();
    }

    function isVerifiedUser() {
      return isEmailUser() && request.auth.token.email_verified == true;
    }

    function isOwner(uid) {
      return isEmailUser() && request.auth.uid == uid;
    }

    // Pre-production note: this bootstrap email acts as an initial verified-admin fallback.
    // Remove or replace with trusted custom-claim/Admin-SDK provisioning after initial setup.
    function isBootstrapAdmin() {
      return isVerifiedUser()
        && request.auth.token.email is string
        && request.auth.token.email.lower() == 'itxmerajkhan3109@gmail.com';
    }

    function getUserDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function userDocHasActiveRole(uDoc, roles) {
      return uDoc != null && uDoc.data.active == true && uDoc.data.role in roles;
    }

    function isDoctorForDoc(uDoc, doctorId) {
      return uDoc != null && uDoc.data.active == true && uDoc.data.role == 'doctor' && uDoc.data.doctorId == doctorId;
    }

    function isApptDocOwner(apptDoc) {
      return apptDoc != null && apptDoc.data.patientUid == request.auth.uid;
    }

    function isAdmin() {
      return isBootstrapAdmin()
        || (isVerifiedUser() && userDocHasActiveRole(getUserDoc(), ['admin']));
    }

    function isReceptionist() {
      return isVerifiedUser() && userDocHasActiveRole(getUserDoc(), ['receptionist']);
    }

    function isAdminOrReceptionist() {
      return isBootstrapAdmin()
        || (isVerifiedUser() && userDocHasActiveRole(getUserDoc(), ['admin', 'receptionist']));
    }

    function isDoctorFor(doctorId) {
      return isVerifiedUser() && isDoctorForDoc(getUserDoc(), doctorId);
    }

    function isStaff() {
      return isBootstrapAdmin()
        || (isVerifiedUser() && userDocHasActiveRole(getUserDoc(), ['admin', 'receptionist', 'doctor']));
    }

    function isValidDateStr(s) {
      return s is string && s.size() == 10 && s.matches('^\\d{4}-(0[1-9]|1[0-2])-(0[1-9]|[12]\\d|3[01])$');
    }

    function isValidTimeStr(s) {
      return s is string && s.size() == 5 && s.matches('^([01]\\d|2[0-3]):[0-5]\\d$');
    }

    function isValidSha256Hex(s) {
      return s is string && s.size() == 64 && s.matches('^[a-f0-9]{64}$');
    }

    // ==================== TIME, GRID & SCHEDULE HELPERS ====================
    function timeStrToMins(t) {
      return (int(t[0:1]) * 10 + int(t[1:2])) * 60 + (int(t[3:4]) * 10 + int(t[4:5]));
    }

    function twoDigitStr(n) {
      return n < 10 ? ('0' + string(n)) : string(n);
    }

    function minsToHhmmConcat(totalMins) {
      return twoDigitStr(int((totalMins - (totalMins % 60)) / 60)) + twoDigitStr(totalMins % 60);
    }

    function expectedLockId(doctorId, date, time) {
      return doctorId + '_' + date + '_' + time[0:2] + time[3:5];
    }

    function expectedSlotLockAt(doctorId, date, startTime, stepMins, idx) {
      return doctorId + '_' + date + '_' + minsToHhmmConcat(timeStrToMins(startTime) + idx * stepMins);
    }

    function apptDateTs(d) {
      return timestamp.date(
        int(d[0:1]) * 1000 + int(d[1:2]) * 100 + int(d[2:3]) * 10 + int(d[3:4]),
        int(d[5:6]) * 10 + int(d[6:7]),
        int(d[8:9]) * 10 + int(d[9:10])
      );
    }

    function apptStartTs(d, t) {
      return apptDateTs(d) + duration.value(timeStrToMins(t), 'm');
    }

    function weekdayKeyForDate(d) {
      return ['mon', 'tue', 'wed', 'thu', 'fri', 'sat', 'sun'][apptDateTs(d).dayOfWeek() - 1];
    }

    function dayOpenMins(clinicDay, docDay) {
      return timeStrToMins(clinicDay.start) > timeStrToMins(docDay.start)
        ? timeStrToMins(clinicDay.start)
        : timeStrToMins(docDay.start);
    }

    function dayCloseMins(clinicDay, docDay) {
      return timeStrToMins(clinicDay.end) < timeStrToMins(docDay.end)
        ? timeStrToMins(clinicDay.end)
        : timeStrToMins(docDay.end);
    }

    function hasLunchBreak(dayMap) {
      return ('lunchStart' in dayMap)
        && ('lunchEnd' in dayMap)
        && isValidTimeStr(dayMap.lunchStart)
        && isValidTimeStr(dayMap.lunchEnd)
        && timeStrToMins(dayMap.lunchStart) < timeStrToMins(dayMap.lunchEnd);
    }

    function effectiveLunchStart(clinicDay, docDay) {
      return hasLunchBreak(docDay) ? timeStrToMins(docDay.lunchStart) : timeStrToMins(clinicDay.lunchStart);
    }

    function effectiveLunchEnd(clinicDay, docDay) {
      return hasLunchBreak(docDay) ? timeStrToMins(docDay.lunchEnd) : timeStrToMins(clinicDay.lunchEnd);
    }

    function noLunchOverlap(startMins, endMins, clinicDay, docDay) {
      return (!hasLunchBreak(docDay) && !hasLunchBreak(clinicDay))
        || endMins <= effectiveLunchStart(clinicDay, docDay)
        || startMins >= effectiveLunchEnd(clinicDay, docDay);
    }

    function isDayBookable(data, docData, clinicDay, docDay, stepMins, startMins, endMins) {
      return clinicDay.enabled == true
        && docDay.enabled == true
        && !(data.date in docData.blockedDates)
        && isValidTimeStr(clinicDay.start) && isValidTimeStr(clinicDay.end)
        && isValidTimeStr(docDay.start) && isValidTimeStr(docDay.end)
        && startMins >= dayOpenMins(clinicDay, docDay)
        && endMins <= dayCloseMins(clinicDay, docDay)
        && ((startMins - dayOpenMins(clinicDay, docDay)) % stepMins) == 0
        && noLunchOverlap(startMins, endMins, clinicDay, docDay);
    }

    function isWithinBookingHorizon(data, cfgData) {
      return apptStartTs(data.date, data.time) >= request.time - duration.value(14, 'h')
        && apptStartTs(data.date, data.time) <= request.time + duration.value((cfgData.maxBookingDaysAhead + 1) * 24 + 14, 'h');
    }

    function hasExactContiguousSlotLocks(data, stepMins) {
      return data.slotLockIds is list
        && data.slotLockIds.size() >= 1
        && data.slotLockIds.size() <= 4
        && stepMins in [15, 30, 45, 60]
        && (data.slotLockIds.size() - 1) * stepMins < data.durationMins
        && data.slotLockIds.size() * stepMins >= data.durationMins
        && timeStrToMins(data.time) + data.slotLockIds.size() * stepMins <= 1440
        && data.slotLockIds[0] == data.slotLockId
        && data.slotLockIds[0] == expectedSlotLockAt(data.doctorId, data.date, data.time, stepMins, 0)
        && (data.slotLockIds.size() < 2 || data.slotLockIds[1] == expectedSlotLockAt(data.doctorId, data.date, data.time, stepMins, 1))
        && (data.slotLockIds.size() < 3 || data.slotLockIds[2] == expectedSlotLockAt(data.doctorId, data.date, data.time, stepMins, 2))
        && (data.slotLockIds.size() < 4 || data.slotLockIds[3] == expectedSlotLockAt(data.doctorId, data.date, data.time, stepMins, 3));
    }

    function isWithinDoctorAndClinicSchedule(data, docData, cfgData, dayKey) {
      return (dayKey in cfgData.workingHours)
        && isWithinBookingHorizon(data, cfgData)
        && isDayBookable(
          data,
          docData,
          cfgData.workingHours[dayKey],
          (dayKey in docData.workingHours) ? docData.workingHours[dayKey] : cfgData.workingHours[dayKey],
          cfgData.slotDurationMins,
          timeStrToMins(data.time),
          timeStrToMins(data.time) + data.slotLockIds.size() * cfgData.slotDurationMins
        );
    }

    function isValidAppointmentSchedule(data, docData, svcData, cfgData) {
      return docData.active == true
        && data.doctorName == docData.name
        && svcData.active == true
        && data.serviceName == svcData.name
        && data.durationMins == svcData.durationMins
        && data.estimatedValue == svcData.basePrice
        && hasExactContiguousSlotLocks(data, cfgData.slotDurationMins)
        && isWithinDoctorAndClinicSchedule(data, docData, cfgData, weekdayKeyForDate(data.date));
    }

    function slotLockBoundToAppointment(lockId, apptId) {
      return getAfter(/databases/$(database)/documents/slotLocks/$(lockId)).data.appointmentId == apptId;
    }

    function allCoveredSlotLocksBoundAfter(data) {
      return slotLockBoundToAppointment(data.slotLockIds[0], data.id)
        && (data.slotLockIds.size() < 2 || slotLockBoundToAppointment(data.slotLockIds[1], data.id))
        && (data.slotLockIds.size() < 3 || slotLockBoundToAppointment(data.slotLockIds[2], data.id))
        && (data.slotLockIds.size() < 4 || slotLockBoundToAppointment(data.slotLockIds[3], data.id));
    }

    function slotLockMatchesApptData(apptData, lockData, lockId) {
      return apptData.status in ['pending', 'confirmed']
        && apptData.doctorId == lockData.doctorId
        && apptData.date == lockData.date
        && lockId in apptData.slotLockIds
        && (
          apptData.patientUid == request.auth.uid
          || isAdminOrReceptionist()
        );
    }

    function visitLookupMatchesCreatedAppt(apptData, lookupData, tokenHash) {
      return apptData.patientUid == lookupData.ownerUid
        && ('guestTokenHash' in apptData)
        && apptData.guestTokenHash == tokenHash
        && apptData.status == lookupData.status
        && apptData.date == lookupData.date
        && apptData.time == lookupData.time
        && apptData.doctorId == lookupData.doctorId
        && apptData.doctorName == lookupData.doctorName
        && apptData.serviceName == lookupData.serviceName
        && apptData.durationMins == lookupData.durationMins
        && apptData.referenceCode == lookupData.referenceCode;
    }

    function visitLookupMatchesUpdatedAppt(apptData, lookupData) {
      return apptData.status == lookupData.status
        && apptData.date == lookupData.date
        && apptData.time == lookupData.time
        && apptData.doctorId == lookupData.doctorId
        && apptData.doctorName == lookupData.doctorName;
    }

    function scheduleFieldsChanged(next, prev) {
      return next.date != prev.date
        || next.time != prev.time
        || next.doctorId != prev.doctorId
        || next.doctorName != prev.doctorName
        || next.serviceId != prev.serviceId
        || next.serviceName != prev.serviceName
        || next.durationMins != prev.durationMins
        || next.estimatedValue != prev.estimatedValue
        || next.slotLockId != prev.slotLockId
        || next.slotLockIds != prev.slotLockIds;
    }

    // ==================== VALIDATION BLUEPRINTS ====================
    function isValidUser(data, userId) {
      return data.keys().hasAll(['uid', 'email', 'displayName', 'role', 'active', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'email', 'displayName', 'photoUrl', 'role', 'doctorId', 'active', 'createdAt', 'updatedAt'])
        && data.uid == userId
        && isValidId(data.uid)
        && data.email is string && data.email.size() >= 3 && data.email.size() <= 160
        && data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 80
        && (!('photoUrl' in data) || (data.photoUrl is string && data.photoUrl.size() <= 500))
        && data.role in ['patient', 'doctor', 'receptionist', 'admin']
        && (!('doctorId' in data) || (data.doctorId is string && data.doctorId.size() <= 64 && data.doctorId.matches('^[a-zA-Z0-9_\\-]*$')))
        && data.active is bool
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidDoctor(data, doctorId) {
      return data.keys().hasAll([
          'id', 'name', 'role', 'specialty', 'bio', 'experience', 'languages',
          'color', 'photoUrl', 'initials', 'active', 'workingHours', 'blockedDates',
          'isSample', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'id', 'name', 'role', 'specialty', 'bio', 'experience', 'languages',
          'color', 'photoUrl', 'initials', 'active', 'workingHours', 'blockedDates',
          'isSample', 'createdAt', 'updatedAt'
        ])
        && data.id == doctorId && isValidId(data.id)
        && data.name is string && data.name.size() >= 2 && data.name.size() <= 80
        && data.role is string && data.role.size() >= 2 && data.role.size() <= 60
        && data.specialty is string && data.specialty.size() >= 2 && data.specialty.size() <= 80
        && data.bio is string && data.bio.size() >= 5 && data.bio.size() <= 500
        && data.experience is string && data.experience.size() >= 2 && data.experience.size() <= 40
        && data.languages is string && data.languages.size() >= 2 && data.languages.size() <= 80
        && data.color is string && data.color.size() >= 4 && data.color.size() <= 16 && data.color.matches('^#[0-9a-fA-F]{3,8}$')
        && data.photoUrl is string && data.photoUrl.size() >= 1 && data.photoUrl.size() <= 300
        && data.initials is string && data.initials.size() >= 1 && data.initials.size() <= 4
        && data.active is bool
        && data.workingHours is map && data.workingHours.size() <= 7
        && data.blockedDates is list && data.blockedDates.size() <= 60
        && (data.blockedDates.size() == 0 || isValidDateStr(data.blockedDates[0]))
        && data.isSample is bool
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidService(data, serviceId) {
      return data.keys().hasAll([
          'id', 'name', 'description', 'includes', 'durationMins', 'priceLabel',
          'basePrice', 'iconKey', 'defaultDoctorId', 'active', 'sortOrder',
          'isSample', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'id', 'name', 'description', 'includes', 'durationMins', 'priceLabel',
          'basePrice', 'iconKey', 'defaultDoctorId', 'active', 'sortOrder',
          'isSample', 'createdAt', 'updatedAt'
        ])
        && data.id == serviceId && isValidId(data.id)
        && data.name is string && data.name.size() >= 2 && data.name.size() <= 80
        && data.description is string && data.description.size() >= 5 && data.description.size() <= 400
        && data.includes is string && data.includes.size() >= 2 && data.includes.size() <= 160
        && data.durationMins is int && data.durationMins >= 15 && data.durationMins <= 240
        && data.priceLabel is string && data.priceLabel.size() >= 1 && data.priceLabel.size() <= 40
        && data.basePrice is number && data.basePrice >= 0 && data.basePrice <= 50000
        && data.iconKey is string && data.iconKey.size() >= 1 && data.iconKey.size() <= 40
        && isValidId(data.defaultDoctorId)
        && data.active is bool
        && data.sortOrder is int && data.sortOrder >= 0 && data.sortOrder <= 1000
        && data.isSample is bool
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidSchedule(data, scheduleId) {
      return data.keys().hasAll([
          'id', 'doctorId', 'date', 'isBlockedDay', 'blockedSlots',
          'reason', 'createdByUid', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'id', 'doctorId', 'date', 'isBlockedDay', 'blockedSlots',
          'reason', 'createdByUid', 'createdAt', 'updatedAt'
        ])
        && data.id == scheduleId && isValidId(data.id)
        && isValidId(data.doctorId)
        && isValidDateStr(data.date)
        && data.isBlockedDay is bool
        && data.blockedSlots is list && data.blockedSlots.size() <= 24
        && (data.blockedSlots.size() == 0 || isValidTimeStr(data.blockedSlots[0]))
        && data.reason is string && data.reason.size() <= 160
        && isValidId(data.createdByUid)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidBusySlot(data, lockId) {
      return data.keys().hasAll(['doctorId', 'date', 'time', 'createdAt'])
        && data.keys().hasOnly(['doctorId', 'date', 'time', 'createdAt'])
        && isValidId(lockId)
        && isValidId(data.doctorId)
        && isValidDateStr(data.date)
        && isValidTimeStr(data.time)
        && lockId == expectedLockId(data.doctorId, data.date, data.time)
        && data.createdAt is timestamp;
    }

    function isValidSlotLock(data, lockId) {
      return data.keys().hasAll(['doctorId', 'date', 'time', 'appointmentId', 'bookedByUid', 'createdAt'])
        && data.keys().hasOnly(['doctorId', 'date', 'time', 'appointmentId', 'bookedByUid', 'createdAt'])
        && isValidId(lockId)
        && isValidId(data.doctorId)
        && isValidDateStr(data.date)
        && isValidTimeStr(data.time)
        && lockId == expectedLockId(data.doctorId, data.date, data.time)
        && isValidId(data.appointmentId)
        && isValidId(data.bookedByUid)
        && data.createdAt is timestamp;
    }

    function hasAllUniqueValidSlotLockIds(data) {
      return data.slotLockIds is list
        && data.slotLockIds.size() >= 1
        && data.slotLockIds.size() <= 4
        && data.slotLockIds[0] == data.slotLockId
        && (data.slotLockIds.size() < 2 || (isValidId(data.slotLockIds[1]) && data.slotLockIds[1] != data.slotLockIds[0]))
        && (data.slotLockIds.size() < 3 || (isValidId(data.slotLockIds[2]) && data.slotLockIds[2] != data.slotLockIds[0] && data.slotLockIds[2] != data.slotLockIds[1]))
        && (data.slotLockIds.size() < 4 || (isValidId(data.slotLockIds[3]) && data.slotLockIds[3] != data.slotLockIds[0] && data.slotLockIds[3] != data.slotLockIds[1] && data.slotLockIds[3] != data.slotLockIds[2]));
    }

    function isValidAppointment(data, apptId) {
      return data.keys().hasAll([
          'id', 'referenceCode', 'patientUid', 'patientName', 'patientPhone',
          'serviceId', 'serviceName', 'doctorId', 'doctorName',
          'date', 'time', 'durationMins', 'estimatedValue', 'status',
          'source', 'notes', 'staffNotes', 'slotLockId', 'slotLockIds', 'isSample',
          'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'id', 'referenceCode', 'patientUid', 'patientName', 'patientPhone', 'patientEmail',
          'serviceId', 'serviceName', 'doctorId', 'doctorName',
          'date', 'time', 'durationMins', 'estimatedValue', 'status',
          'source', 'notes', 'staffNotes', 'slotLockId', 'slotLockIds', 'guestTokenHash', 'isSample',
          'createdAt', 'updatedAt'
        ])
        && data.id == apptId && isValidId(data.id)
        && data.referenceCode is string && data.referenceCode.size() >= 4 && data.referenceCode.size() <= 20
        && isValidId(data.patientUid)
        && data.patientName is string && data.patientName.size() >= 2 && data.patientName.size() <= 80
        && data.patientPhone is string && data.patientPhone.size() >= 7 && data.patientPhone.size() <= 24
        && (!('patientEmail' in data) || (data.patientEmail is string && data.patientEmail.size() <= 160))
        && isValidId(data.serviceId)
        && data.serviceName is string && data.serviceName.size() >= 2 && data.serviceName.size() <= 80
        && isValidId(data.doctorId)
        && data.doctorName is string && data.doctorName.size() >= 2 && data.doctorName.size() <= 80
        && isValidDateStr(data.date)
        && isValidTimeStr(data.time)
        && data.durationMins is int && data.durationMins >= 15 && data.durationMins <= 240
        && data.estimatedValue is number && data.estimatedValue >= 0 && data.estimatedValue <= 50000
        && data.status in ['pending', 'confirmed', 'completed', 'cancelled', 'no_show']
        && data.source in ['form', 'chatbot', 'whatsapp', 'phone', 'walkin', 'staff']
        && data.notes is string && data.notes.size() <= 400
        && data.staffNotes is string && data.staffNotes.size() <= 400
        && isValidId(data.slotLockId)
        && data.slotLockId == expectedLockId(data.doctorId, data.date, data.time)
        && hasAllUniqueValidSlotLockIds(data)
        && (!('guestTokenHash' in data) || isValidSha256Hex(data.guestTokenHash))
        && data.isSample is bool
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidVisitLookup(data, tokenHash) {
      return data.keys().hasAll([
          'id', 'appointmentId', 'ownerUid', 'referenceCode', 'serviceName',
          'doctorId', 'doctorName', 'date', 'time', 'durationMins', 'status',
          'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'id', 'appointmentId', 'ownerUid', 'referenceCode', 'serviceName',
          'doctorId', 'doctorName', 'date', 'time', 'durationMins', 'status',
          'createdAt', 'updatedAt'
        ])
        && data.id == tokenHash && isValidSha256Hex(data.id)
        && isValidId(data.appointmentId)
        && isValidId(data.ownerUid)
        && data.referenceCode is string && data.referenceCode.size() >= 4 && data.referenceCode.size() <= 20
        && data.serviceName is string && data.serviceName.size() >= 2 && data.serviceName.size() <= 80
        && isValidId(data.doctorId)
        && data.doctorName is string && data.doctorName.size() >= 2 && data.doctorName.size() <= 80
        && isValidDateStr(data.date)
        && isValidTimeStr(data.time)
        && data.durationMins is int && data.durationMins >= 15 && data.durationMins <= 240
        && data.status in ['pending', 'confirmed', 'completed', 'cancelled', 'no_show']
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidPatient(data, patientId) {
      return data.keys().hasAll(['id', 'fullName', 'phone', 'totalAppointments', 'notes', 'isSample', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['id', 'uid', 'fullName', 'phone', 'email', 'preferredDoctorId', 'lastVisitDate', 'totalAppointments', 'notes', 'isSample', 'createdAt', 'updatedAt'])
        && data.id == patientId && isValidId(data.id)
        && (!('uid' in data) || (data.uid is string && data.uid.size() <= 128))
        && data.fullName is string && data.fullName.size() >= 2 && data.fullName.size() <= 80
        && data.phone is string && data.phone.size() >= 7 && data.phone.size() <= 24
        && (!('email' in data) || (data.email is string && data.email.size() <= 160))
        && (!('preferredDoctorId' in data) || (data.preferredDoctorId is string && data.preferredDoctorId.size() <= 64))
        && (!('lastVisitDate' in data) || (data.lastVisitDate is string && data.lastVisitDate.size() <= 10))
        && data.totalAppointments is int && data.totalAppointments >= 0 && data.totalAppointments <= 10000
        && data.notes is string && data.notes.size() <= 300
        && data.isSample is bool
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidInquiry(data, inquiryId) {
      return data.keys().hasAll([
          'id', 'patientUid', 'channel', 'name', 'contact', 'topic',
          'status', 'priority', 'estimatedValue', 'internalNotes',
          'unread', 'messages', 'isSample', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'id', 'referenceCode', 'patientUid', 'channel', 'name', 'contact', 'topic',
          'status', 'priority', 'assignedToUid', 'assignedToName',
          'estimatedValue', 'internalNotes', 'unread', 'messages',
          'isSample', 'createdAt', 'updatedAt'
        ])
        && data.id == inquiryId && isValidId(data.id)
        && (!('referenceCode' in data) || (data.referenceCode is string && data.referenceCode.size() >= 4 && data.referenceCode.size() <= 20))
        && isValidId(data.patientUid)
        && data.channel in ['website', 'chatbot', 'whatsapp', 'phone']
        && data.name is string && data.name.size() >= 2 && data.name.size() <= 80
        && data.contact is string && data.contact.size() >= 5 && data.contact.size() <= 120
        && data.topic is string && data.topic.size() >= 2 && data.topic.size() <= 40
        && data.status in ['new', 'contacted', 'follow_up', 'closed']
        && data.priority in ['normal', 'urgent']
        && (!('assignedToUid' in data) || (data.assignedToUid is string && data.assignedToUid.size() <= 128))
        && (!('assignedToName' in data) || (data.assignedToName is string && data.assignedToName.size() <= 80))
        && data.estimatedValue is number && data.estimatedValue >= 0 && data.estimatedValue <= 50000
        && data.internalNotes is string && data.internalNotes.size() <= 500
        && data.unread is bool
        && data.messages is list && data.messages.size() >= 1 && data.messages.size() <= 50
        && data.messages[0] is map
        && data.isSample is bool
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidClinicSettings(data, settingId) {
      return data.keys().hasAll([
          'id', 'clinicName', 'address', 'phone', 'email',
          'slotDurationMins', 'minLeadTimeMins', 'maxBookingDaysAhead',
          'workingHours', 'holidays', 'allowChatbotBooking', 'requireConfirmation', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'id', 'clinicName', 'address', 'phone', 'email',
          'slotDurationMins', 'minLeadTimeMins', 'maxBookingDaysAhead',
          'workingHours', 'holidays', 'allowChatbotBooking', 'requireConfirmation',
          'updatedByUid', 'updatedAt'
        ])
        && data.id == settingId && isValidId(data.id)
        && data.clinicName is string && data.clinicName.size() >= 2 && data.clinicName.size() <= 80
        && data.address is string && data.address.size() >= 5 && data.address.size() <= 200
        && data.phone is string && data.phone.size() >= 7 && data.phone.size() <= 30
        && data.email is string && data.email.size() >= 5 && data.email.size() <= 120
        && data.slotDurationMins in [15, 30, 45, 60]
        && data.minLeadTimeMins is int && data.minLeadTimeMins >= 0 && data.minLeadTimeMins <= 1440
        && data.maxBookingDaysAhead is int && data.maxBookingDaysAhead >= 7 && data.maxBookingDaysAhead <= 180
        && data.workingHours is map && data.workingHours.size() <= 7
        && data.holidays is list && data.holidays.size() <= 50
        && (data.holidays.size() == 0 || data.holidays[0] is map)
        && data.allowChatbotBooking is bool
        && data.requireConfirmation is bool
        && (!('updatedByUid' in data) || (data.updatedByUid is string && data.updatedByUid.size() <= 128))
        && data.updatedAt is timestamp;
    }

    function isValidAuditLog(data, logId) {
      return data.keys().hasAll(['id', 'actorUid', 'actorEmail', 'actorRole', 'action', 'targetCollection', 'targetId', 'summary', 'createdAt'])
        && data.keys().hasOnly(['id', 'actorUid', 'actorEmail', 'actorRole', 'action', 'targetCollection', 'targetId', 'summary', 'createdAt'])
        && data.id == logId && isValidId(data.id)
        && isValidId(data.actorUid)
        && data.actorEmail is string && data.actorEmail.size() >= 3 && data.actorEmail.size() <= 160
        && data.actorRole in ['admin', 'receptionist', 'doctor']
        && data.action is string && data.action.size() >= 3 && data.action.size() <= 80
        && data.targetCollection is string && data.targetCollection.size() >= 2 && data.targetCollection.size() <= 40
        && isValidId(data.targetId)
        && data.summary is string && data.summary.size() >= 3 && data.summary.size() <= 300
        && data.createdAt is timestamp;
    }

    // ==================== COLLECTION RULES ====================

    // Connection test doc
    match /test/connection {
      allow get: if true;
      allow list, write: if false;
    }

    // Users & RBAC Roles (Strict PII isolation; anonymous auth excluded; staff/admin require verified email)
    match /users/{userId} {
      allow get: if isValidId(userId) && (isOwner(userId) || isAdminOrReceptionist());
      allow list: if isAdminOrReceptionist();
      allow create: if isValidId(userId)
        && isOwner(userId)
        && isValidUser(incoming(), userId)
        && request.auth.token.email is string
        && incoming().email == request.auth.token.email
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && incoming().active == true
        && (
          incoming().role == 'patient'
          || (isBootstrapAdmin() && incoming().role == 'admin')
        );
      allow update: if isValidId(userId)
        && isValidUser(incoming(), userId)
        && incoming().uid == existing().uid
        && incoming().email == existing().email
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          (isAdmin() && incoming().diff(existing()).affectedKeys().hasOnly(['role', 'doctorId', 'active', 'displayName', 'updatedAt']))
          || (isOwner(userId) && incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'photoUrl', 'updatedAt']))
        );
      allow delete: if false;
    }

    // Public Clinic Doctors Catalog (no personal PII)
    match /doctors/{doctorId} {
      allow get: if isValidId(doctorId);
      allow list: if true;
      allow create: if isValidId(doctorId)
        && isAdmin()
        && isValidDoctor(incoming(), doctorId)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isValidId(doctorId)
        && isValidDoctor(incoming(), doctorId)
        && incoming().id == existing().id
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          isAdmin()
          || (isDoctorFor(doctorId) && incoming().diff(existing()).affectedKeys().hasOnly(['workingHours', 'blockedDates', 'updatedAt']))
        );
      allow delete: if isValidId(doctorId) && isAdmin();
    }

    // Public Services & Pricing Catalog
    match /services/{serviceId} {
      allow get: if isValidId(serviceId);
      allow list: if true;
      allow create: if isValidId(serviceId)
        && isAdmin()
        && isValidService(incoming(), serviceId)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isValidId(serviceId)
        && isAdmin()
        && isValidService(incoming(), serviceId)
        && incoming().id == existing().id
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time;
      allow delete: if isValidId(serviceId) && isAdmin();
    }

    // Doctor Schedules & Blocked Leave Overrides (non-PII availability)
    match /schedules/{scheduleId} {
      allow get: if isValidId(scheduleId);
      allow list: if true;
      allow create: if isValidId(scheduleId)
        && isValidSchedule(incoming(), scheduleId)
        && incoming().createdByUid == request.auth.uid
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && (isAdminOrReceptionist() || isDoctorFor(incoming().doctorId))
        && exists(/databases/$(database)/documents/doctors/$(incoming().doctorId));
      allow update: if isValidId(scheduleId)
        && isValidSchedule(incoming(), scheduleId)
        && incoming().id == existing().id
        && incoming().doctorId == existing().doctorId
        && incoming().createdByUid == existing().createdByUid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (isAdminOrReceptionist() || isDoctorFor(existing().doctorId));
      allow delete: if isValidId(scheduleId)
        && (isAdminOrReceptionist() || isDoctorFor(existing().doctorId));
    }

    // Public Non-PII Occupied Calendar Slots (zero bookedByUid, zero appointmentId, zero PII)
    match /busySlots/{lockId} {
      allow get: if isValidId(lockId);
      allow list: if true;
      allow create: if isValidId(lockId)
        && isSignedIn()
        && isValidBusySlot(incoming(), lockId)
        && incoming().createdAt == request.time
        && existsAfter(/databases/$(database)/documents/slotLocks/$(lockId));
      allow update: if false;
      allow delete: if isValidId(lockId)
        && isSignedIn()
        && (
          !existsAfter(/databases/$(database)/documents/slotLocks/$(lockId))
          || isAdminOrReceptionist()
          || isDoctorFor(existing().doctorId)
        );
    }

    // Private Atomic Slot Locks (owner or verified staff only — no public enumeration)
    match /slotLocks/{lockId} {
      allow get: if isValidId(lockId)
        && isSignedIn()
        && (
          resource == null
          || isStaff()
          || existing().bookedByUid == request.auth.uid
        );
      allow list: if isSignedIn()
        && (isStaff() || resource.data.bookedByUid == request.auth.uid);
      allow create: if isValidId(lockId)
        && isSignedIn()
        && isValidSlotLock(incoming(), lockId)
        && incoming().bookedByUid == request.auth.uid
        && incoming().createdAt == request.time
        && slotLockMatchesApptData(
          getAfter(/databases/$(database)/documents/appointments/$(incoming().appointmentId)).data,
          incoming(),
          lockId
        );
      allow update: if false;
      allow delete: if isValidId(lockId)
        && isSignedIn()
        && (
          existing().bookedByUid == request.auth.uid
          || isAdminOrReceptionist()
          || isDoctorFor(existing().doctorId)
          || isApptDocOwner(get(/databases/$(database)/documents/appointments/$(existing().appointmentId)))
        );
    }

    // Appointments (Strict Catalog, Schedule, Duration, Contiguous Locks & Ownership Checks)
    match /appointments/{appointmentId} {
      allow get: if isValidId(appointmentId)
        && isSignedIn()
        && (
          existing().patientUid == request.auth.uid
          || isAdminOrReceptionist()
          || isDoctorFor(existing().doctorId)
        );
      allow list: if isSignedIn() && (
        resource.data.patientUid == request.auth.uid
        || isAdminOrReceptionist()
        || isDoctorFor(resource.data.doctorId)
      );
      allow create: if isValidId(appointmentId)
        && isSignedIn()
        && isValidAppointment(incoming(), appointmentId)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && (
          (
            incoming().status in ['pending', 'confirmed']
            && allCoveredSlotLocksBoundAfter(incoming())
            && isValidAppointmentSchedule(
              incoming(),
              get(/databases/$(database)/documents/doctors/$(incoming().doctorId)).data,
              get(/databases/$(database)/documents/services/$(incoming().serviceId)).data,
              get(/databases/$(database)/documents/clinicSettings/main).data
            )
          )
          || (
            isAdmin()
            && incoming().isSample == true
            && incoming().status == 'completed'
            && exists(/databases/$(database)/documents/doctors/$(incoming().doctorId))
            && exists(/databases/$(database)/documents/services/$(incoming().serviceId))
          )
        )
        && (
          (
            incoming().patientUid == request.auth.uid
            && incoming().status == 'pending'
            && incoming().source in ['form', 'chatbot']
            && incoming().staffNotes == ''
            && incoming().isSample == false
          )
          || (
            isAdminOrReceptionist()
            && incoming().status in ['pending', 'confirmed', 'completed']
          )
        );
      allow update: if isValidId(appointmentId)
        && isSignedIn()
        && isValidAppointment(incoming(), appointmentId)
        && incoming().id == existing().id
        && incoming().referenceCode == existing().referenceCode
        && incoming().patientUid == existing().patientUid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          !(incoming().status in ['pending', 'confirmed'])
          || (
            allCoveredSlotLocksBoundAfter(incoming())
            && (
              !scheduleFieldsChanged(incoming(), existing())
              || isValidAppointmentSchedule(
                incoming(),
                get(/databases/$(database)/documents/doctors/$(incoming().doctorId)).data,
                get(/databases/$(database)/documents/services/$(incoming().serviceId)).data,
                get(/databases/$(database)/documents/clinicSettings/main).data
              )
            )
          )
        )
        && (
          // Owning Patient / Anonymous Guest: only non-terminal appointments, can cancel or reschedule (resets to pending)
          (
            existing().patientUid == request.auth.uid
            && existing().status in ['pending', 'confirmed']
            && (
              (incoming().status == 'cancelled' && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt']))
              || (incoming().status == 'pending' && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'date', 'time', 'slotLockId', 'slotLockIds', 'updatedAt']))
            )
          )
          // Admin or Receptionist: confirm, reschedule, complete, cancel, no_show, notes
          || (
            isAdminOrReceptionist()
            && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'date', 'time', 'doctorId', 'doctorName', 'serviceId', 'serviceName', 'durationMins', 'estimatedValue', 'staffNotes', 'slotLockId', 'slotLockIds', 'updatedAt'])
          )
          // Doctor: only own assigned appointments, transition confirmed -> completed | no_show or update staffNotes
          || (
            isDoctorFor(existing().doctorId)
            && existing().status == 'confirmed'
            && incoming().status in ['confirmed', 'completed', 'no_show']
            && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'staffNotes', 'updatedAt'])
          )
        );
      allow delete: if isValidId(appointmentId) && isAdmin();
    }

    // Non-PII Visit Status Lookup (keyed by 64-hex SHA-256 of non-guessable guest secret; list forbidden)
    match /visitLookups/{tokenHash} {
      allow get: if isValidSha256Hex(tokenHash) && isSignedIn();
      allow list: if false;
      allow create: if isValidSha256Hex(tokenHash)
        && isSignedIn()
        && isValidVisitLookup(incoming(), tokenHash)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && visitLookupMatchesCreatedAppt(
          getAfter(/databases/$(database)/documents/appointments/$(incoming().appointmentId)).data,
          incoming(),
          tokenHash
        )
        && (
          (incoming().ownerUid == request.auth.uid && incoming().status in ['pending', 'confirmed'])
          || (isAdminOrReceptionist() && incoming().status in ['pending', 'confirmed'])
        );
      allow update: if isValidSha256Hex(tokenHash)
        && isSignedIn()
        && isValidVisitLookup(incoming(), tokenHash)
        && incoming().id == existing().id
        && incoming().appointmentId == existing().appointmentId
        && incoming().ownerUid == existing().ownerUid
        && incoming().referenceCode == existing().referenceCode
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && visitLookupMatchesUpdatedAppt(
          getAfter(/databases/$(database)/documents/appointments/$(existing().appointmentId)).data,
          incoming()
        )
        && (
          (
            existing().ownerUid == request.auth.uid
            && existing().status in ['pending', 'confirmed']
            && incoming().status in ['pending', 'cancelled']
            && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'date', 'time', 'updatedAt'])
          )
          || (
            (isAdminOrReceptionist() || isDoctorFor(existing().doctorId))
            && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'date', 'time', 'doctorId', 'doctorName', 'updatedAt'])
          )
        );
      allow delete: if isValidSha256Hex(tokenHash) && isAdmin();
    }

    // Minimal Authorized Patient Directory (Staff-only list; own doc readable/updatable during booking tx)
    match /patients/{patientId} {
      allow get: if isValidId(patientId) && (
        (isSignedIn() && patientId == request.auth.uid)
        || isStaff()
      );
      allow list: if isStaff();
      allow create: if isValidId(patientId)
        && isSignedIn()
        && isValidPatient(incoming(), patientId)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && (
          (
            patientId == request.auth.uid
            && incoming().uid == request.auth.uid
            && incoming().totalAppointments == 1
            && incoming().notes == ''
            && incoming().isSample == false
          )
          || isAdminOrReceptionist()
        );
      allow update: if isValidId(patientId)
        && isSignedIn()
        && isValidPatient(incoming(), patientId)
        && incoming().id == existing().id
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          (
            patientId == request.auth.uid
            && existing().uid == request.auth.uid
            && incoming().uid == existing().uid
            && incoming().diff(existing()).affectedKeys().hasOnly(['fullName', 'phone', 'email', 'preferredDoctorId', 'totalAppointments', 'updatedAt'])
          )
          || isAdminOrReceptionist()
        );
      allow delete: if isValidId(patientId) && isAdmin();
    }

    // Inquiries & CRM Pipeline (Anonymous guests can create 'new' single-user-message inquiry and read their own)
    match /inquiries/{inquiryId} {
      allow get: if isValidId(inquiryId)
        && isSignedIn()
        && (existing().patientUid == request.auth.uid || isAdminOrReceptionist());
      allow list: if isSignedIn()
        && (resource.data.patientUid == request.auth.uid || isAdminOrReceptionist());
      allow create: if isValidId(inquiryId)
        && isSignedIn()
        && isValidInquiry(incoming(), inquiryId)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && (
          (
            incoming().patientUid == request.auth.uid
            && incoming().channel in ['website', 'chatbot']
            && incoming().status == 'new'
            && incoming().unread == true
            && incoming().internalNotes == ''
            && incoming().estimatedValue <= 500
            && !('assignedToUid' in incoming())
            && !('assignedToName' in incoming())
            && incoming().isSample == false
            && incoming().messages.size() == 1
            && incoming().messages[0].keys().hasAll(['from', 'text', 'ts'])
            && incoming().messages[0].keys().hasOnly(['from', 'text', 'ts'])
            && incoming().messages[0].from == 'user'
            && incoming().messages[0].text is string
            && incoming().messages[0].text.size() >= 1
            && incoming().messages[0].text.size() <= 500
            && incoming().messages[0].ts is string
            && incoming().messages[0].ts.size() <= 40
          )
          || isAdminOrReceptionist()
        );
      allow update: if isValidId(inquiryId)
        && isAdminOrReceptionist()
        && isValidInquiry(incoming(), inquiryId)
        && incoming().id == existing().id
        && incoming().patientUid == existing().patientUid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time;
      allow delete: if isValidId(inquiryId) && isAdmin();
    }

    // Clinic Settings
    match /clinicSettings/{settingId} {
      allow get: if isValidId(settingId);
      allow list: if true;
      allow create: if isValidId(settingId)
        && isAdmin()
        && isValidClinicSettings(incoming(), settingId)
        && incoming().updatedAt == request.time;
      allow update: if isValidId(settingId)
        && isAdmin()
        && isValidClinicSettings(incoming(), settingId)
        && incoming().id == existing().id
        && incoming().updatedAt == request.time;
      allow delete: if false;
    }

    // Immutable Staff Audit Logs
    match /auditLogs/{logId} {
      allow get: if isValidId(logId) && isAdminOrReceptionist();
      allow list: if isAdminOrReceptionist();
      allow create: if isValidId(logId)
        && isStaff()
        && isValidAuditLog(incoming(), logId)
        && incoming().actorUid == request.auth.uid
        && incoming().createdAt == request.time;
      allow update, delete: if false;
    }
  }
}
